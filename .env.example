# ==============================================================================
# Autonomous Red Team & PenTest AI Engine - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your desired AI backend provider:
# 1. Cloud Provider: Google Gemini (default)
# 2. Local Provider: Ollama (100% Offline / Self-Hosted, e.g. Llama 3.2, DeepSeek)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI CLOUD AI CONFIGURATION
# ------------------------------------------------------------------------------
# In Google AI Studio, this is automatically injected via the Secrets panel.
# When running locally or deploying, insert your Gemini API Key below.
GEMINI_API_KEY=

# Primary Gemini Model (defaults to gemini-3.7-flash with extended reasoning)
# Supported options: gemini-3.7-flash, gemini-flash-latest, gemini-3.1-pro-preview, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.7-flash


# ------------------------------------------------------------------------------
# 2. LOCAL OLLAMA CONFIGURATION (100% Offline & Private)
# ------------------------------------------------------------------------------
# To use Ollama locally:
#   1. Install Ollama: https://ollama.com
#   2. Pull your model: `ollama run llama3.2` (or deepseek-r1, mistral, qwen2.5-coder)
#   3. Set LLM_PROVIDER=ollama below:
LLM_PROVIDER=auto

# Ollama API Host URL (Default: http://localhost:11434 or http://127.0.0.1:11434)
# If running inside Docker on Mac/Windows, use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Model Name
# Recommended: llama3.2, llama3.1, deepseek-r1, qwen2.5-coder, mistral, codellama
OLLAMA_MODEL=llama3.2


# ------------------------------------------------------------------------------
# 3. SERVER & NETWORK RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Application URL for callbacks and references
APP_URL=http://localhost:3000

# Port for the Express + Vite server (Default: 3000)
PORT=3000
